# ============================================================
# Creeper World 3 汉化工程
# 仓库根 = 游戏安装根目录
#
# 思路：顶层用【白名单】（只放行工程相关项），子目录内再用黑名单细化。
# 这样游戏本体、Steam、Unity 运行时产生的任何东西都不会误入库。
#
# ★★★ 警告 ★★★
# 本目录就是游戏安装目录。git clean -xdf / git clean -fd 会删掉
# 整个游戏（CW3.exe、CW3_Data 全部处于被忽略状态）。
# 永远不要在这里执行 git clean。
# ============================================================

# ---------- 顶层：默认全部忽略 ----------
/*
!/.gitignore
!/.gitattributes
!/AGENTS.md
!/doorstop_config.ini
!/.doorstop_version
!/_cw3hanhua/
!/BepInEx/

# ---------- 对外发布物（GitHub 首页 / 许可，必须入库） ----------
# README.md 是唯一允许的「第二份 md」：GitHub 首页没有它就等于没有门面。
# 内部技术知识仍然只在 _cw3hanhua/NOTES.md 一份，见那边维护纪律第 1 条。
!/README.md
!/LICENSE
!/NOTICE

# ---------- BepInEx：只保留装机补丁的配置 ----------
# core/ 是 BepInEx 自带二进制，重装即可；plugins/ 是编译产物
/BepInEx/*
!/BepInEx/config/
/BepInEx/config/*
!/BepInEx/config/BepInEx.cfg

# 插件编译产物：用 _cw3hanhua\tools\build_plugin.cmd 重建
/BepInEx/plugins/*.dll
/BepInEx/plugins/*.dll.off
# 探针往 BepInEx 根目录写的报告、运行日志、缓存
/BepInEx/*.txt
/BepInEx/*.log
/BepInEx/cache/

# ---------- 工程目录：排除大块外部资产 ----------
# Python 虚拟环境
/_cw3hanhua/.venv/
# NGUI 上游源码（自带 .git，嵌套会变 gitlink）
/_cw3hanhua/_ngui_repo/
# ILSpy 反编译工具二进制
/_cw3hanhua/tools/ilspycmd/
# ★ 反编译源码：随时可用 tools\ilspy.cmd 重生成，不必入库
#   例：& tools\ilspy.cmd CW3_Data\Managed\Assembly-CSharp.dll -t UIFont
/_cw3hanhua/_diag/
# Python 缓存
__pycache__/
*.pyc

# ★ 游戏原始资产备份（约 84 MB）。绝不能入库：这是游戏本体文件，
#   由 tools\bake_textmesh_assets.py --backup 从游戏目录复制生成。
/_cw3hanhua/_assets_orig/

# ---------- 临时文件 ----------
/_cw3hanhua/_tmp/

# 全量翻译工作目录（译稿已并入 batches/，「不译」决策在 _dict/skipped_manual.json）
/_cw3hanhua/_dict/work/
# 一次性统计脚本的产物（已删除，此处防止再误入库）
/_cw3hanhua/_tmp_dump*

# ---------- 下划线开头的临时脚本与备份 ----------
# tools/_dbg.py、tools/_tmp_quotes.py 这类一次性探查脚本，调试完就该删；
# 万一忘了删，别让它们入库。
/_cw3hanhua/tools/_*.py
# strings.json 改动前的快照（每个约 1 MB，可由 git 历史找回）
/_cw3hanhua/_dict/*.bak*
/_cw3hanhua/_dict/*.bak
# 插件运行时写的「未命中」诊断件（F5 的产物，每次开游戏都可能变，不入库）
/_cw3hanhua/_dict/miss_dump.txt
# 一次性剧情提取原始对照表（已废弃，不入库）
/_cw3hanhua/_dict/story_raw.json
